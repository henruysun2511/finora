# ─── Finora Mobile App Environment Config ──────────────────────────────────
# Base URL trỏ tới Finora Backend API
# - Chạy trên Chrome / Web / iOS Simulator / Windows: http://localhost:3000/api/v1
# - Chạy trên Android Emulator: http://10.0.2.2:3000/api/v1
# - Chạy trên thiết bị thật (cùng mạng Wi-Fi LAN): http://192.168.1.xxx:3000/api/v1
# - Production server: https://api.finora.vn/api/v1
BASE_URL=http://localhost:3000/api/v1

# WebSocket Gateway URL (dành cho socket notifications/updates)
SOCKET_URL=http://localhost:3000

# Network Timeouts (giây)
CONNECT_TIMEOUT_SECONDS=15
RECEIVE_TIMEOUT_SECONDS=15

# Google OAuth2 (Web Client ID tạo từ Google Cloud Console)
GOOGLE_SERVER_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
